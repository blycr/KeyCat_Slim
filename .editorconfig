root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,swift,metal,hlsl,h,c,py}]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,sh,plist}]
indent_style = space
indent_size = 2

[*.nsi]
charset = utf-8-bom
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
